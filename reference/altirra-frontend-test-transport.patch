+	const char *inFd = std::getenv("ALTIRRA_TESTMODE_IN_FD");
+	const char *outFd = std::getenv("ALTIRRA_TESTMODE_OUT_FD");
+	if (inFd && outFd) {
+		mClientFd = dup(std::atoi(inFd));
